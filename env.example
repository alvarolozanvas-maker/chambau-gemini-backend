# Gemini API key (server secret; never put this in Shopify Liquid or browser JavaScript)
GEMINI_API_KEY=
# Set this to a currently supported Gemini model for your account.
GEMINI_MODEL=
# Shopify app proxy shared secret, configured in the app/backend provider.
SHOPIFY_APP_SECRET=
# Optional allow-list; keep the store domain exact in production.
SHOPIFY_SHOP_DOMAIN=c1b1g2-91.myshopify.com
PORT=8787
# Only for local testing without Shopify proxy. Keep false in production.
ALLOW_DEV_ENDPOINT=false
